# Optional. No secrets belong here.
# Base URL of the hosted Merkle proof files (no trailing slash), e.g. a CDN or Vercel Blob URL.
# Layout: <base>/<pool>/meta.json and <base>/<pool>/<xx>.json. Unset = pools show "list not published".
VITE_PROOFS_BASE_URL=
# Arbitrum One RPC for contract reads (defaults to https://arb1.arbitrum.io/rpc).
VITE_ARBITRUM_RPC_URL=
